# Your own Supabase project (Project Settings -> API)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Public — safe in the browser, LinkedIn shows it in the OAuth URL anyway.
VITE_LINKEDIN_CLIENT_ID=your-linkedin-client-id

# Set these as SECRETS on your Supabase project (Edge Functions -> Secrets),
# NOT in this file:
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/callback/linkedin
